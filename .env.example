# ==============================================================================
# CrimeLens AI — Environment Configuration Template
# ==============================================================================
# CrimeLens AI runs 100% locally and offline out-of-the-box.
# No third-party API keys or cloud tokens are required for core forensic analysis,
# scenario generation, or evidence relationship mapping.
#
# Copy this file to '.env' if you wish to customize local developer parameters:
#   cp .env.example .env
# ==============================================================================

# Local Development Server Port (Default: 3000)
VITE_PORT=3000

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Simulated Analysis Latency in milliseconds (Default: 800)
# Adjusts the simulated optical normalization and re-ranking delay
VITE_SIMULATED_ANALYSIS_LATENCY_MS=800

# Enable Forensic Verbose Console Logging ('true' | 'false')
VITE_ENABLE_VERBOSE_LOGS=false

# ------------------------------------------------------------------------------
# Future / Planned External Vision Integrations (Optional)
# ------------------------------------------------------------------------------
# In the current prototype, optical detections and scenario evaluations use
# deterministic offline forensic heuristics. Leave these blank to use offline mode.
# VITE_EXTERNAL_VISION_API_URL=
# VITE_EXTERNAL_VISION_API_KEY=
